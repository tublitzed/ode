generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "ts"
}

datasource db {
  provider = "postgresql"
}

model SharedOde {
  id         String   @id @default(cuid(2))
  topic      String
  ode        String
  comparison Json?
  createdAt  DateTime @default(now()) @map("created_at")

  @@map("shared_odes")
}
