generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "ts"
}

datasource db {
  provider = "postgresql"
}

model SharedOde {
  id         String   @id @default(cuid(2))
  comparison Json? // See Comparison type in shared/ode.ts
  createdAt  DateTime @default(now()) @map("created_at")
  ode        String
  topic      String
}
