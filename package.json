{
  "name": "ode",
  "version": "0.0.1",
  "description": "making odes... with Anthropic :)",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "prisma generate && vite build",
    "build-storybook": "storybook build",
    "dev": "tsx watch --env-file-if-exists=.env --import ./src/server/instrument.ts src/server/index.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "oxlint --deny-warnings",
    "lint:fix": "oxlint --fix",
    "migrate:dev": "prisma migrate dev",
    "migrate:reset:dev": "prisma migrate reset",
    "prepare": "husky",
    "start": "NODE_ENV=production node --env-file-if-exists=.env --import ./src/server/instrument.ts src/server/index.ts",
    "storybook": "storybook dev",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "worktree": "npx -y -p github:pariodot/utils worktree-sync"
  },
  "lint-staged": {
    "*.{cjs,js,jsx,mjs,ts,tsx}": [
      "oxlint --fix --deny-warnings",
      "prettier --write --ignore-unknown"
    ],
    "*.{css,html,json,md,yaml,yml}": "prettier --write --ignore-unknown"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@fontsource-variable/figtree": "^5.3.0",
    "@fontsource-variable/newsreader": "^5.3.0",
    "@fontsource/young-serif": "^5.3.0",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@sentry/node": "^11.10.0",
    "@sentry/react": "^11.10.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.1",
    "cookie": "^2.0.1",
    "express": "^5.3.0",
    "logrocket": "^12.4.0",
    "lucide-react": "^1.66.0",
    "prisma": "7.10.1",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@sentry/vite-plugin": "^11.10.0",
    "@storybook/react-vite": "^10.6.5",
    "@tailwindcss/vite": "^4.3.3",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/supertest": "^7.2.1",
    "@vitejs/plugin-react": "^6.1.2",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "oxlint": "^1.90.0",
    "prettier": "^3.9.10",
    "shadcn": "^4.23.0",
    "storybook": "^10.6.5",
    "supertest": "^7.3.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "allowScripts": {
    "@prisma/engines@7.10.1": true,
    "prisma@7.10.1": true,
    "esbuild": false,
    "fsevents": false
  }
}
