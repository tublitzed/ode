{
  "name": "ode",
  "version": "0.0.1",
  "description": "making odes...with Anthropic :)",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server/index.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "oxlint --deny-warnings",
    "lint:fix": "oxlint --fix",
    "prepare": "husky",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "worktree": "npx -y -p github:pariodot/utils worktree-sync"
  },
  "lint-staged": {
    "*.{cjs,js,jsx,mjs,ts,tsx}": [
      "oxlint --fix --deny-warnings",
      "prettier --write --ignore-unknown"
    ],
    "*.{css,html,json,md,yaml,yml}": "prettier --write --ignore-unknown"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.1",
    "cookie": "^2.0.1",
    "express": "^5.3.0",
    "lucide-react": "^1.66.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/supertest": "^7.2.1",
    "@vitejs/plugin-react": "^6.1.2",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "oxlint": "^1.90.0",
    "prettier": "^3.9.10",
    "shadcn": "^4.23.0",
    "supertest": "^7.3.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
